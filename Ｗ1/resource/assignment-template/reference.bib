  author    = {Cox, Gary W.},
  title     = {The Efficient Secret: The Cabinet and the Development of Political Parties in Victorian England},
  year      = {1987},
  publisher = {Cambridge University Press}
}

@book{carey2009,
  author    = {Carey, John M.},
